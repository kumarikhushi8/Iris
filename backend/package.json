{
  "name": "iris-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Iris backend - CI failure diagnosis, sandbox validation, and human-approved remediation",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/src/main.js",
    "start:worker": "ts-node -r tsconfig-paths/register src/worker/main.ts",
    "start:worker:prod": "node dist/src/worker/main.js",
    "test:sandbox": "ts-node -r tsconfig-paths/register scripts/test-sandbox.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:prod": "prisma migrate deploy",
    "db:seed": "npx ts-node prisma/seed.ts",
    "seed:eval": "npx ts-node prisma/seed-eval-set.ts",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest"
  },
  "dependencies": {
    "@nestjs/bullmq": "^10.2.0",
    "@nestjs/common": "^10.4.0",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/platform-express": "^10.4.0",
    "@octokit/auth-app": "^7.1.3",
    "@octokit/rest": "^21.0.2",
    "@prisma/client": "^5.20.0",
    "adm-zip": "^0.6.0",
    "bullmq": "^5.13.2",
    "diff": "^9.0.0",
    "groq-sdk": "^0.7.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "tar-stream": "^3.2.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.5",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.0",
    "@types/adm-zip": "^0.5.8",
    "@types/diff": "^7.0.2",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.14.15",
    "@types/tar-stream": "^3.1.4",
    "jest": "^30.4.2",
    "prisma": "^5.20.0",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.5.4"
  }
}
