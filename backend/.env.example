# Database
DATABASE_URL="postgresql://iris:iris_dev_password@localhost:5432/iris?schema=public"

# Redis / Queue
REDIS_HOST=localhost
REDIS_PORT=6379

# GitHub App
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=./secrets/github-app-private-key.pem
GITHUB_WEBHOOK_SECRET=

# AI provider (development default: Groq free tier)
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
SEMANTIC_RETRIEVAL_ENABLED=false

# Sandbox (Phase 3 - not yet used by Phase 0 code)
SANDBOX_MAX_RUNTIME_MS=600000
SANDBOX_MEMORY_LIMIT_MB=2048
SANDBOX_CPU_LIMIT=1

# Diagnosis retry policy (Phase 3)
DIAGNOSIS_MAX_RETRIES=3

# Server
PORT=3000
