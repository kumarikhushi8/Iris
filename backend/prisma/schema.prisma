generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [vector]
}

// -- users --------------------------------------------------------------
// See backend-schema.md "users"
model User {
  id        String   @id @default(uuid())
  githubId  String   @unique @map("github_id")
  name      String?
  email     String?
  role      String   @default("developer") // "developer" | "reviewer" | "admin"
  createdAt DateTime @default(now()) @map("created_at")

  repos     Repo[]
  approvals Approval[]

  @@map("users")
}

// -- repos ----------------------------------------------------------------
// See backend-schema.md "repos"
model Repo {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  githubRepoId   String   @unique @map("github_repo_id")
  name           String
  installationId String   @map("installation_id")
  autonomyLevel  String   @default("comment_only") @map("autonomy_level") // "comment_only" | "draft_pr_eligible"
  createdAt      DateTime @default(now()) @map("created_at")

  user       User            @relation(fields: [userId], references: [id])
  builds     Build[]
  embeddings CodeEmbedding[]

  @@map("repos")
}

// -- builds -----------------------------------------------------------------
// See backend-schema.md "builds"
model Build {
  id         String    @id @default(uuid())
  repoId     String    @map("repo_id")
  commitSha  String    @map("commit_sha")
  branch     String
  status     String    // "queued" | "diagnosing" | "passed" | "failed"
  durationMs Int?      @map("duration_ms")
  startedAt  DateTime  @default(now()) @map("started_at")
  finishedAt DateTime? @map("finished_at")

  repo       Repo            @relation(fields: [repoId], references: [id])
  diagnosis  Diagnosis?
  evaluation EvaluationSet?

  @@index([repoId, branch])
  @@index([repoId, startedAt])
  @@map("builds")
}

// -- diagnoses ----------------------------------------------------------
// See backend-schema.md "diagnoses"
model Diagnosis {
  id         String   @id @default(uuid())
  buildId    String   @unique @map("build_id")
  rootCause  String?  @map("root_cause") @db.Text
  fixType    String?  @map("fix_type")
  proposedDiff String?  @map("proposed_diff") @db.Text
  confidence Float?
  retryCount Int      @default(0) @map("retry_count")
  status     String   @default("diagnosing") // "diagnosing" | "validating" | "awaiting_approval" | "approved" | "rejected" | "inconclusive"
  createdAt  DateTime @default(now()) @map("created_at")

  build       Build        @relation(fields: [buildId], references: [id])
  sandboxRuns SandboxRun[]
  approval    Approval?

  @@index([status])
  @@map("diagnoses")
}

// -- sandbox_runs ------------------------------------------------------
// See backend-schema.md "sandbox_runs" (Phase 3)
model SandboxRun {
  id          String   @id @default(uuid())
  diagnosisId String   @map("diagnosis_id")
  result      String   // "pass" | "fail" | "timeout"
  testLog     String?  @map("test_log") @db.Text
  durationMs  Int?     @map("duration_ms")
  createdAt   DateTime @default(now()) @map("created_at")

  diagnosis Diagnosis @relation(fields: [diagnosisId], references: [id])

  @@index([diagnosisId])
  @@map("sandbox_runs")
}

// -- approvals ---------------------------------------------------------------
// See backend-schema.md "approvals" (Phase 4)
model Approval {
  id          String    @id @default(uuid())
  diagnosisId String    @unique @map("diagnosis_id")
  reviewerId  String?   @map("reviewer_id")
  decision    String    @default("pending") // "pending" | "approved" | "changes_requested" | "rejected"
  prUrl       String?   @map("pr_url")
  reviewedAt  DateTime? @map("reviewed_at")

  diagnosis Diagnosis @relation(fields: [diagnosisId], references: [id])
  reviewer  User?     @relation(fields: [reviewerId], references: [id])

  @@index([decision])
  @@map("approvals")
}

// -- code_embeddings (pgvector) ------------------------------------------
// See backend-schema.md "code_embeddings" (Phase 2)
model CodeEmbedding {
  id        String                 @id @default(uuid())
  repoId    String                 @map("repo_id")
  filePath  String                 @map("file_path")
  chunkText String                 @map("chunk_text") @db.Text
  embedding Unsupported("vector(768)")
  updatedAt DateTime               @default(now()) @map("updated_at")

  repo Repo @relation(fields: [repoId], references: [id])

  @@index([repoId])
  @@map("code_embeddings")
}

// -- evaluation_set ---------------------------------------------------------
// See backend-schema.md "evaluation_set" (Phase 5)
model EvaluationSet {
  id                String   @id @default(uuid())
  buildId           String   @unique @map("build_id")
  expectedRootCause String   @map("expected_root_cause") @db.Text
  match             Boolean?

  build Build @relation(fields: [buildId], references: [id])

  @@map("evaluation_set")
}
